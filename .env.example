# ═══════════════════════════════════════════════════════
# STRIVE PILATES BALI — Environment Variables
# Copy file ini menjadi .env dan isi nilai yang sesuai
# JANGAN commit file .env ke Git repository!
# ═══════════════════════════════════════════════════════

# ── APP ──────────────────────────────────────────────
APP_NAME="Strive Pilates Bali"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Makassar

# ── DATABASE ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=strive_pilates
DB_USERNAME=strive_user
DB_PASSWORD=strive_password
DB_ROOT_PASSWORD=rootpassword

# ── REDIS ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── QUEUE ────────────────────────────────────────────
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# ── SANCTUM (JWT) ────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1
SESSION_DOMAIN=localhost

# ── MIDTRANS ─────────────────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Production keys (ganti saat go-live):
# MIDTRANS_SERVER_KEY=Mid-server-XXXXXXXXXXXXXXXXXXXXXX
# MIDTRANS_CLIENT_KEY=Mid-client-XXXXXXXXXXXXXXXXXXXXXX
# MIDTRANS_IS_PRODUCTION=true

# ── FONNTE (WhatsApp) ────────────────────────────────
FONNTE_TOKEN=XXXXXXXXXXXXXXXXXXXX
FONNTE_URL=https://api.fonnte.com/send
FONNTE_SENDER=628XXXXXXXXXX

# ── MAIL (untuk verifikasi email) ────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@strivepilates.bali
MAIL_FROM_NAME="Strive Pilates Bali"

# ── STORAGE ──────────────────────────────────────────
FILESYSTEM_DISK=local
# Untuk production dengan S3:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=strive-pilates

# ── FRONTEND (React/Vite) ────────────────────────────
VITE_APP_NAME="Strive Pilates Bali"
VITE_API_URL=http://localhost/api
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXXXX
VITE_APP_ENV=local
